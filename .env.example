# control-plane
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_URL=http://127.0.0.1:8080
DEFAULT_ORG_ID=org_local
DEFAULT_USER_ID=user_local
DEFAULT_MODEL=neo/deepseek
# local | docker | none | vm
WORKER_RUNTIME=local
SPAWN_LOCAL_WORKER=1
RUNS_DIR=.neo/runs
HOST_RUNS_DIR=
# Optional worker-facing URL overrides. Leave commented for local/in-process.
# WORKER_CONTROL_PLANE_URL=
# WORKER_LLM_GATEWAY_URL=
WORKER_WORKSPACE_MOUNT=/workspace
DOCKER_NETWORK=

# Web client
# pnpm dev:web -> Web UI :5173 against local :8080

# llm-gateway (the only process that may hold provider keys)
LLM_GATEWAY_PORT=8081
LLM_GATEWAY_URL=http://127.0.0.1:8081
LLM_GATEWAY_JWT_SECRET=dev-only-change-me
# mock | openai | deepseek
# If unset: deepseek when DEEPSEEK_API_KEY is set, openai when OPENAI_API_KEY is set, otherwise mock.
LLM_UPSTREAM=mock
LLM_UPSTREAM_BASE_URL=
LLM_UPSTREAM_MODEL=
LLM_UPSTREAM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_API_KEY=
ANTHROPIC_API_KEY=

# worker (injected per Run; not a cluster Deployment)
RUN_ID=
LLM_GATEWAY_JWT=
WORKSPACE_DIR=/workspace
SESSION_DIR=/var/neo/sessions
NEO_MODEL=neo/deepseek

# Accounts (login form is empty; default admin / 123456)
# ACCOUNTS_REQUIRED=1
# DEFAULT_ADMIN=1
# DEFAULT_ADMIN_PASSWORD=123456
# BOOTSTRAP_EMAIL=you@example.com
# BOOTSTRAP_PASSWORD=at-least-8-chars
# ADMIN_EMAILS=ops@example.com

# Optional metadata / hot events (unset = .control JSON + in-process bus)
# DATABASE_URL=postgres://neo:neo@127.0.0.1:5432/neo
# REDIS_URL=redis://:pass@127.0.0.1:6379

# Optional quotas. 0 or unset = unlimited.
# QUOTA_MAX_TOKENS_MONTH=0
# QUOTA_MAX_CONCURRENT_RUNS=0
